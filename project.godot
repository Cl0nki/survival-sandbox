; Engine configuration file.
; Godot 4.7.2 — Milestone 1 local prototype.

config_version=5

[application]

config/name="Survival Sandbox"
config/description="Milestone 1 local prototype: angled top-down 3D movement, camera, aiming, and hitscan."
config/icon="res://icon.svg"
run/main_scene="res://scenes/world/test_arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputBindings="*res://scripts/core/input_bindings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="damageable"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
