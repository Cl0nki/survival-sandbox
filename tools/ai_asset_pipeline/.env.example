# Copy to tools/ai_asset_pipeline/.env (gitignored). Keys stay in the process only.
# The dashboard receives configured: true/false — never the secret values.

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

MESHY_API_KEY=
MESHY_AI_MODEL=latest

TRIPO_API_KEY=
TRIPO_MODEL_VERSION=v2.5-20250123

# Optional tools
BLENDER_BIN=
GODOT_BIN=

# Optional overrides
# PIPELINE_LIBRARY_DIR=
# PIPELINE_HOST=127.0.0.1
# PIPELINE_PORT=8765
# PIPELINE_POLL_TIMEOUT_SEC=900
